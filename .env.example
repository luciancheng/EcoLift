# ── Raspberry Pi / Backend ──
# No env vars needed — just pass --device and --port as CLI args to main.py

# ── Dashboard (React) ──
# Copy this to dashboard/.env and set your Pi's IP address.
# For local development (Pi code running on same machine), use localhost.
# For remote Pi, use its Tailscale IP (e.g. 100.x.x.x).

VITE_PI_HOST=localhost
VITE_PI_PORT=8765
